.env
.env.*
!.env.example

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
.cache/
.vite/

# Operating system files
.DS_Store
Thumbs.db

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo

# Android local/build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
*.apk
*.aab
*.aar

# Never commit Android signing credentials
*.jks
